# Supabase Configuration
SUPABASE_URL=https://ylnusvrdxnljuryxhzgp.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Model Weight Paths
YOLO_WEIGHTS_PATH=weights/deepfashion2_yolov8s-seg.pt
FASHION_RULES_PATH=rules/fashion_rules.json

# Fashion classifier. Marqo/marqo-fashionSigLIP is the Apache-2.0 fallback
# and needs `pip install open_clip_torch`.
FASHION_MODEL_ID=srpone/zooclaw-fashionsiglip2
# Set to 1 to skip the YOLOE shoe, bag and accessory detector.
DISABLE_ACCESSORY_DETECTOR=0
# Background removal for color reading. birefnet-general-lite is sharper but
# about 9 s per item on CPU instead of 0.7 s.
REMBG_MODEL=isnet-general-use
DISABLE_BACKGROUND_REMOVAL=0

# Inference Device
DEVICE=cpu
